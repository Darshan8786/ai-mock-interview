# ── Required ────────────────────────────────────────────
MONGO_URL = mongodb://localhost:27017/mindprep
MONGO_URI = mongodb://localhost:27017/mindprep
JWT_SECRET = your-jwt-secret

# ── AI Service Configuration (required — this is where local AI lives) ──
AI_SERVICE_URL=http://localhost:5001
AI_SERVICE_KEY=mindprep-ai-key-2026

# Set true to force zero external network calls: ignores PINECONE_API_KEY
# even if set (vector search always uses the local MongoDB-backed store) and
# makes `npm run gen:aptitude` refuse to run (it calls Groq). Nothing else in
# this backend calls an external AI provider at all, with or without this
# flag — see docs/LOCAL_AI_MIGRATION_AUDIT.md.
LOCAL_ONLY=false

# ── Optional / local-only ───────────────────────────────
OLLAMA_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text

# PINECONE_* enable the MANAGED-CLOUD vector store for quiz-question search
# and mock-interview RAG context. Leave unset (recommended for local-only
# operation) and both features keep working via a local, MongoDB-backed
# vector store instead — no functionality is lost, only the storage backend
# changes. Set these only if you specifically want Pinecone's managed index
# (ignored outright if LOCAL_ONLY=true).
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=us-east-1
PINECONE_INDEX_NAME=MindPrep-AI

# Used ONLY by the offline `npm run gen:aptitude` authoring script (never run
# by the deployed app, never called by any request). Not needed to run
# MindPrep AI itself.
GROQ_API_KEY=

# Live job search (Adzuna) — not an AI provider. Optional; the app runs
# normally without it, job search just reports "not configured".
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Seeded admin account (created on first start) and the college it manages.
# College interviews are scoped to this college; create admins for other colleges with
#   npm run create:college-admin -- --college "ABC College" --name "Name" --email a@b.edu --password "..."
# ADMIN_EMAIL=admin@mindprep.ai
# ADMIN_PASSWORD=change-me
# ADMIN_NAME=Admin
# ADMIN_COLLEGE=MindPrep Demo College
