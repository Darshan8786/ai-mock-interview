# ── Required ────────────────────────────────────────────
AI_SERVICE_PORT=8000
PROCTOR_PORT=8001
AI_SERVICE_KEY=mindprep-ai-key-2026

# ── Local-only (no external call, safe defaults shown) ──
# Speech-to-text: faster-whisper (CPU, int8), fully offline. Bigger = more
# accurate, slower, more RAM. tiny ~75MB, base ~150MB (default), small ~500MB.
WHISPER_MODEL_SIZE=base

# NVIDIA Riva (optional managed speech service) — leave false to use the
# local faster-whisper (STT) / pyttsx3+SAPI (TTS) path, which requires
# nothing external.
RIVA_ENABLED=false
RIVA_SERVER=localhost:50051

MONGO_URL=mongodb://localhost:27017/mindprep

# ── Optional / external fallback only ──────────────────
# Not needed for mock-interview question generation, resume enhancement, or
# the chatbot — all of those already run fully locally. Leave unset unless
# you specifically want an external-model fallback.
GROQ_API_KEY=
NIM_API_URL=https://api.nvcf.nvidia.com/v2/nvcf
NIM_API_KEY=
NIM_MODEL=meta/llama-3.1-405b-instruct
