# Frontend runtime config. Copy to `.env` and adjust as needed.
# NOTE: everything here is exposed to the browser — never put a paid AI-provider
# key (Groq / Gemini / OpenAI / NIM) in this file. Those stay server-side only.

# Backend Express API
VITE_BACKEND_URL=http://localhost:3001

# placement-admin-be (Alumni management, alumni job openings) — port 5001
# Its CLIENT_URL must include this app's origin (default http://localhost:5173).
VITE_ADMIN_API_URL=http://localhost:5001

# Legacy Flask AI service (question generation / evaluation / STT / TTS) — port 8000
VITE_AI_SERVICE_URL=http://127.0.0.1:8000

# FastAPI proctoring service WebSocket — port 8001
# Use 127.0.0.1 not "localhost" — "localhost" adds a ~2s IPv6->IPv4 fallback
# on every connection on Windows.
VITE_PROCTOR_WS_URL=ws://127.0.0.1:8001

# Internal service-to-service shared secret (X-AI-Service-Key).
# This is NOT a provider API key — it only gates the local AI service.
VITE_AI_SERVICE_KEY=mindprep-ai-key-2026
