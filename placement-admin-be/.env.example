# ── Server ──────────────────────────────────────────────
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ── Database ────────────────────────────────────────────
MONGO_URI=mongodb://127.0.0.1:27017/mindprep_placement

# ── JWT ─────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-access-secret-32chars-minimum!!
JWT_REFRESH_SECRET=change-me-refresh-secret-32chars-minimum!!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Default Admin (seeded on first boot) ────────────────
ADMIN_EMAIL=admin@mindprep.ai
ADMIN_PASSWORD=Admin@123
ADMIN_NAME=Super Admin
ADMIN_PHONE=+91 0000000000

# ── Swagger ─────────────────────────────────────────────
SWAGGER_UI=/api/docs
